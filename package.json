{
  "name": "kabye-en-poche",
  "version": "0.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "ts:check": "tsc",
    "lint": "eslint --fix .",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "commitlint": "commitlint --edit",
    "admin": "cd admin && npm run dev",
    "admin:build": "cd admin && npm run build",
    "data:download": "node --env-file=.env ./scripts/getAlphabet.js",
    "clean": "find . -name 'node_modules' -type d -prune -print -exec rm -rf '{}' + && find . -name 'package-lock.json' -type f -prune -print -exec rm -rf '{}' +",
    "postclean": "./scripts/install-all.sh",
    "renovate": "node ./renovate.js && ncu -u && cd admin && ncu -u && cd ../website && ncu -u",
    "postrenovate": "npm run clean",
    "bundle:analyze": "EXPO_ATLAS=true npx expo start --clear --no-dev",
    "pretestflight": "npm run i18n:extract",
    "testflight": "npx testflight",
    "i18n:extract": "lingui extract --clean",
    "//not used, we use po files with metro bundler: i18n:compile": "lingui compile",
    "//not used, we use po files with metro bundler: i18n:extract-compile": "lingui extract && lingui compile",
    "test": "jest",
    "test:watch": "jest --watch",
    "debug-output": "eas build:inspect --platform android --stage archive --output ./debug-output"
  },
  "dependencies": {
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans-hebrew": "^0.4.1",
    "@expo/metro-runtime": "~56.0.5",
    "@jonasmerlin/react-native-markdown-display": "github:jonasmerlin/react-native-markdown-display",
    "@lingui/core": "^6.0.0",
    "@lingui/macro": "^5.9.5",
    "@lingui/react": "^6.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/auth": "^24.0.0",
    "@react-native-firebase/crashlytics": "^24.0.0",
    "@supabase/supabase-js": "^2.104.0",
    "@tanstack/react-query": "^5.99.2",
    "airtable": "^0.12.2",
    "clsx": "^2.1.1",
    "expo": "^56.0.0-preview.7",
    "expo-application": "~56.0.3",
    "expo-audio": "~56.0.3",
    "expo-build-properties": "~56.0.5",
    "expo-clipboard": "~56.0.3",
    "expo-constants": "~56.0.6",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.4",
    "expo-localization": "~56.0.3",
    "expo-router": "~56.1.1",
    "expo-secure-store": "~56.0.3",
    "expo-splash-screen": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.4",
    "expo-updates": "~56.0.6",
    "expo-web-browser": "~56.0.4",
    "intl-pluralrules": "^2.0.1",
    "jest-expo": "~56.0.0",
    "phosphor-react-native": "^3.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-draggable": "^3.3.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-ease": "^0.7.0",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.0-beta.3",
    "react-native-sortable-grid": "^2.0.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "sonner-native": "^0.24.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "uniwind": "^1.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@lingui/babel-plugin-lingui-macro": "^6.0.0",
    "@lingui/babel-plugin-transform-react": "^2.9.2",
    "@lingui/metro-transformer": "^6.0.0",
    "@react-native/eslint-config": "^0.85.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "babel-plugin-macros": "^3.1.0",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "eslint": "^10.2.1",
    "eslint-config-expo": "~56.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "expo-atlas": "^0.4.3",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react-compiler-runtime": "^19.1.0-rc.3",
    "tailwindcss": "^4.1.18",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.0"
  },
  "overrides": {
    "hermes-compiler": "250829098.0.4"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|phosphor-react-native|sonner-native|uniwind|tailwind-variants|tailwind-merge)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "private": true
}
