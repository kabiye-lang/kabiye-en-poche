{
  "name": "kabye-en-poche",
  "version": "0.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "ts:check": "tsc",
    "lint": "eslint --fix .",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "commitlint": "commitlint --edit",
    "admin": "cd admin && npm run dev",
    "admin:build": "cd admin && npm run build",
    "data:download": "node --env-file=.env ./scripts/getAlphabet.js",
    "clean": "find . -name 'node_modules' -type d -prune -print -exec rm -rf '{}' + && find . -name 'package-lock.json' -type f -prune -print -exec rm -rf '{}' +",
    "postclean": "./scripts/install-all.sh",
    "renovate": "node ./renovate.js && ncu -u && cd admin && ncu -u && cd ../website && ncu -u",
    "postrenovate": "npm run clean",
    "bundle:analyze": "EXPO_ATLAS=true npx expo start --clear --no-dev",
    "pretestflight": "npm run i18n:extract",
    "testflight": "npx testflight",
    "i18n:extract": "lingui extract",
    "//not used, we use po files with metro bundler: i18n:compile": "lingui compile",
    "//not used, we use po files with metro bundler: i18n:extract-compile": "lingui extract && lingui compile"
  },
  "dependencies": {
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
