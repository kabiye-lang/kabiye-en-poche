{
    "editor.formatOnSave": true,
    "[yml]": {
        "editor.codeActionsOnSave": {
            "source.fixAll": "never"
        }
    },
    "javascript.validate.enable": true,
    "[javascript]": {
        "editor.formatOnSave": false,
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit",
            "source.fixAll.stylelint": "never"
        },
    },
    "[typescript]": {
        "editor.formatOnSave": false,
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit",
            "source.fixAll.stylelint": "never",
            "source.fixAll.deno": "never"
        },
    },
    "[typescriptreact]": {
        "editor.formatOnSave": false,
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit",
            "source.fixAll.stylelint": "never",
            "source.fixAll.deno": "never"
        },
    },
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.validate.enable": true,
    "typescript.format.enable": false,
    "i18n-ally.localesPaths": [
        "i18n"
    ],
    "i18n-ally.keystyle": "nested",
    "[typescript][typescriptreact]": {
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit",
            "source.fixAll.stylelint": "never",
            "source.fixAll.deno": "never"
        }
    },
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/flutter/ephemeral": true,
        "**/Flutter/ephemeral": true,
        "**/.symlinks": true,
        "**/.plugin_symlinks": true,
        "**/CVS": true
    },
    "explorerExclude.backup": {},
    "tailwindCSS.classAttributes": [
        "class",
        "className",
        "headerClassName"
    ],
    "tailwindCSS.experimental.classRegex": [
        [
            "([\"'`][^\"'`]*.*?[\"'`])",
            "[\"'`]([^\"'`]*).*?[\"'`]"
        ]
    ],
    "gitlens.ai.generateCommitMessage.customInstructions": "The first line should be a single line summary with no more than 50 characters. The second line should be blank. Start the full summary on the third line. The body should be no longer than 100 characters."
}