{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kabiye-en-poche-website",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "directory": "./dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Top-level config is used for local `wrangler dev` only.
  // CI always deploys with --env staging or --env production.
  // -------------------------------------------------------------------------
  "env": {
    "staging": {
      "name": "kabiye-en-poche-website-staging"
      // "routes": [
      //   {
      //     // TODO: replace with actual staging custom domain
      //     "pattern": "staging.kabiye-en-poche.app",
      //     "custom_domain": true
      //   }
      // ]
    },
    "production": {
      "name": "kabiye-en-poche-website"
      // "routes": [
      //   {
      //     // TODO: replace with actual production custom domain
      //     "pattern": "kabiye-en-poche.app",
      //     "custom_domain": true
      //   }
      // ]
    }
  }
}