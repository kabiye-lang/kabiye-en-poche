{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "baseBranchPatterns": [
    "develop"
  ],
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "1 day",
  "prConcurrentLimit": 8,
  "prHourlyLimit": 2,
  "ignoreDeps": [
    "@babel/types",
    "expo",
    "@expo/dom-webview",
    "@expo/fingerprint",
    "@expo/metro-runtime",
    "@expo/vector-icons",
    "@expo/ui",
    "@react-native-async-storage/async-storage",
    "@react-native-community/datetimepicker",
    "@react-native-masked-view/masked-view",
    "@react-native-community/slider",
    "@react-native-community/netinfo",
    "@react-native-community/viewpager",
    "@react-native-picker/picker",
    "@react-native-segmented-control/segmented-control",
    "@stripe/stripe-react-native",
    "eslint-config-expo",
    "expo-analytics-amplitude",
    "expo-app-auth",
    "expo-app-loader-provider",
    "expo-app-metrics",
    "expo-apple-authentication",
    "expo-application",
    "expo-asset",
    "expo-audio",
    "expo-auth-session",
    "expo-background-fetch",
    "expo-background-task",
    "expo-battery",
    "expo-blur",
    "expo-brightness",
    "expo-brownfield",
    "expo-build-properties",
    "expo-calendar",
    "expo-camera",
    "expo-cellular",
    "expo-checkbox",
    "expo-clipboard",
    "expo-constants",
    "expo-contacts",
    "expo-crypto",
    "expo-dev-client",
    "expo-device",
    "expo-document-picker",
    "expo-eas-client",
    "expo-file-system",
    "expo-font",
    "expo-gl",
    "expo-glass-effect",
    "expo-google-app-auth",
    "expo-haptics",
    "expo-image",
    "expo-image-loader",
    "expo-image-manipulator",
    "expo-image-picker",
    "expo-intent-launcher",
    "expo-insights",
    "expo-keep-awake",
    "expo-linear-gradient",
    "expo-linking",
    "expo-local-authentication",
    "expo-localization",
    "expo-location",
    "expo-mail-composer",
    "expo-manifests",
    "expo-maps",
    "expo-mcp",
    "expo-media-library",
    "expo-mesh-gradient",
    "expo-module-template",
    "expo-modules-core",
    "expo-navigation-bar",
    "expo-network",
    "expo-notifications",
    "expo-observe",
    "expo-print",
    "expo-live-photo",
    "expo-router",
    "expo-screen-capture",
    "expo-screen-orientation",
    "expo-secure-store",
    "expo-sensors",
    "expo-server",
    "expo-sharing",
    "expo-sms",
    "expo-speech",
    "expo-splash-screen",
    "expo-sqlite",
    "expo-status-bar",
    "expo-store-review",
    "expo-symbols",
    "expo-system-ui",
    "expo-task-manager",
    "expo-tracking-transparency",
    "expo-updates",
    "expo-video-thumbnails",
    "expo-video",
    "expo-web-browser",
    "expo-widgets",
    "jest-expo",
    "lottie-react-native",
    "react",
    "react-dom",
    "react-native",
    "react-native-web",
    "react-native-gesture-handler",
    "react-native-get-random-values",
    "react-native-keyboard-controller",
    "react-native-maps",
    "react-native-pager-view",
    "react-native-worklets",
    "react-native-reanimated",
    "react-native-screens",
    "react-native-safe-area-context",
    "react-native-svg",
    "react-native-view-shot",
    "react-native-webview",
    "react-server-dom-webpack",
    "sentry-expo",
    "unimodules-app-loader",
    "unimodules-image-loader-interface",
    "@shopify/react-native-skia",
    "@shopify/flash-list",
    "@sentry/react-native",
    "react-native-bootsplash"
  ],
  "packageRules": [
    {
      "description": "GitHub Actions - group all updates, pin to SHA digest, automerge",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "pinDigests": true,
      "automerge": true
    },
    {
      "description": "NPM - only check major updates; skip everything else to speed up runs and cut resource usage",
      "matchFileNames": [
        "package.json",
        "mobile/package.json",
        "admin/package.json",
        "website/package.json"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance"
      ],
      "enabled": false
    },
    {
      "description": "NPM - group all major updates into one PR",
      "matchFileNames": [
        "package.json",
        "mobile/package.json",
        "admin/package.json",
        "website/package.json"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "Major npm dependencies"
    }
  ]
}
