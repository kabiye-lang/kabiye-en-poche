{
  "lesson_title": "Lesson about Kabiye Alphabet and Sounds",
  "objectives": [
    "Recognize and pronounce letters in the Kabiye alphabet",
    "Understand the sounds represented by each letter"
  ],
  "key_vocabulary": [
    {
      "kabiye": "a",
      "english": "pronounced as 'a' as in 'father'"
    },
    {
      "kabiye": "b",
      "english": "pronounced as 'b' as in 'boy'"
    },
    {
      "kabiye": "c",
      "english": "pronounced as 'c' as in 'church'"
    },
    {
      "kabiye": "d",
      "english": "pronounced as 'd' as in 'dog'"
    },
    {
      "kabiye": "ɖ",
      "english": "pronounced as 'ɖ' (leather, made by flicking the tongue against the palate toward the back of the mouth)"
    },
    {
      "kabiye": "ɖɔm",
      "english": "pronounced as 'ɖɔm' (salt)"
    },
    {
      "kabiye": "e",
      "english": "pronounced as 'ɛ' (red, bet)"
    },
    {
      "kabiye": "f",
      "english": "pronounced as 'f' as in 'fish'"
    },
    {
      "kabiye": "g",
      "english": "pronounced as 'ɣ' (pretend you are gargling at the end of the syllable)"
    },
    {
      "kabiye": "haɣ",
      "english": "pronounced as 'haɣ'"
    },
    {
      "kabiye": "fénaɣ",
      "english": "pronounced as 'fénaɣ'"
    },
    {
      "kabiye": "gb",
      "english": "pronounced as 'gb' (say ''egg-beater'' fast ; drop the ''-ter'' then the first ''e'')"
    },
    {
      "kabiye": "nátaŋgbálà",
      "english": "pronounced as 'nátaŋgbálà' (sandals)"
    },
    {
      "kabiye": "h",
      "english": "pronounced as 'h' as in 'hat'"
    },
    {
      "kabiye": "ɩ",
      "english": "pronounced as 'ɩ' (bit)"
    },
    {
      "kabiye": "j",
      "english": "pronounced as 'ɟ' (jogging)"
    },
    {
      "kabiye": "k",
      "english": "pronounced as 'k' as in 'kitten'"
    },
    {
      "kabiye": "kp",
      "english": "pronounced as 'kp' (say pick-pocket fast; drop the ''-ket'' then the ''pi'')"
    },
    {
      "kabiye": "l",
      "english": "pronounced as 'l' as in 'lady'"
    },
    {
      "kabiye": "m",
      "english": "pronounced as 'm' as in 'man'"
    },
    {
      "kabiye": "mb",
      "english": "pronounced as 'mb' (cassava)"
    }
  ],
