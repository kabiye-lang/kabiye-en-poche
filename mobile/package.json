{
  "name": "kabye-en-poche",
  "version": "0.0.1",
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check-types": "tsc",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "admin": "cd admin && pnpm run dev",
    "admin:build": "cd admin && pnpm run build",
    "bundle:analyze": "EXPO_ATLAS=true npx expo start --clear --no-dev",
    "pretestflight": "pnpm run i18n:extract",
    "testflight": "pnpm dlx testflight",
    "i18n:extract": "lingui extract --clean",
    "//not used, we use po files with metro bundler: i18n:compile": "lingui compile",
    "//not used, we use po files with metro bundler: i18n:extract-compile": "lingui extract && lingui compile",
    "test": "jest",
    "test:watch": "jest --watch",
    "debug-output": "eas build:inspect --platform android --stage archive --output ./debug-output"
  },
  "dependencies": {
    "@babel/plugin-transform-export-namespace-from": "^8.0.1",
    "@expo-google-fonts/andika": "^0.4.1",
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
