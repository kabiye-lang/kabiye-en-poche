{
  "name": "kabye-en-poche",
  "version": "0.0.1",
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check-types": "tsc",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "admin": "cd admin && pnpm run dev",
    "admin:build": "cd admin && pnpm run build",
    "bundle:analyze": "EXPO_ATLAS=true npx expo start --clear --no-dev",
    "pretestflight": "pnpm run i18n:extract",
    "testflight": "pnpm dlx testflight",
    "i18n:extract": "lingui extract --clean",
    "//not used, we use po files with metro bundler: i18n:compile": "lingui compile",
    "//not used, we use po files with metro bundler: i18n:extract-compile": "lingui extract && lingui compile",
    "test": "jest",
    "test:watch": "jest --watch",
    "debug-output": "eas build:inspect --platform android --stage archive --output ./debug-output"
  },
  "dependencies": {
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@expo-google-fonts/andika": "^0.4.1",
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo/metro-runtime": "~58.0.14",
    "@jonasmerlin/react-native-markdown-display": "github:jonasmerlin/react-native-markdown-display",
    "@lingui/core": "^6.1.0",
    "@lingui/macro": "^5.9.5",
    "@lingui/react": "^6.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^26.0.0",
    "@react-native-firebase/auth": "^26.0.0",
    "@react-native-firebase/crashlytics": "^26.0.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.100.14",
    "clsx": "^2.1.1",
    "expo": "58.0.11",
    "expo-application": "~58.1.1",
    "expo-asset": "~58.0.16",
    "expo-audio": "~58.0.9",
    "expo-build-properties": "~58.0.10",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
